import "../static/JetBrainsMono-Regular.ttf";
import { CustomInput } from "./components/input-field.slint";
import { CustomButton } from "./components/button.slint";
import { OAuthIcon } from "./components/oauth-icon.slint";
import { ChatPage } from "./chat/chat-page.slint";
import { DebugPage } from "./debug/debug-page.slint";
import { UiState, Message, DebugCommand } from "./app-state.slint";
export { UiState }

export component AppWindow inherits Window {
    title: "echelon";
    preferred-width: 1000px;
    preferred-height: 800px;
    background: #000000;
    default-font-family: "JetBrains Mono";

    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> homeserver: "matrix.org";
    in-out property <string> error: "";
    in-out property <bool> loading: false;
    in-out property <bool> show_password: false;

    callback login(string, string, string);
    callback oauth_action(string, string);
    callback open_chat();
    callback forgot_password();
    callback matrix-message(string, string, string, string, string);
    in-out property <string> result: "";

    // Generic debug console (dev-only): command registry is populated from Rust
    // (commands::debug::COMMANDS) so adding a backend command doesn't require any UI changes.
    callback debug-run-command(string, string, string, string, string);
    in-out property <[DebugCommand]> debug-commands: [];
    in-out property <bool> debug-busy: false;
    in-out property <string> debug-output: "(no commands run yet)";

    in-out property <int> active-page: 0;

    if active-page == 0 : VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 320px;
                alignment: center;
                spacing: 12px;

                Text {
                    text: "echelon";
                    color: #38BDF8;
                    font-size: 64px;
                    font-weight: 400;
                    horizontal-alignment: center;
                }

                Rectangle { height: 28px; }

                CustomInput {
                    placeholder: "username";
                    text: root.username;
                    edited(val) => { root.username = val; }
                    enabled: !root.loading;
                    accepted => { root.login(root.username, root.password, root.homeserver); }
                }

                CustomInput {
                    placeholder: "password";
                    text: root.password;
                    edited(val) => { root.password = val; }
                    input-type: root.show_password ? InputType.text : InputType.password;
                    is-password: true;
                    show-password: root.show_password;
                    // wait, show-password is a boolean, we can't easily map it if it's not a text field.
                    // Let's keep it as is, or remove it. I'll revert this chunk actually, let's just do text fields.
                    enabled: !root.loading;
                    accepted => { root.login(root.username, root.password, root.homeserver); }
                }

                CustomInput {
                    placeholder: "homeserver";
                    text: root.homeserver;
                    edited(val) => { root.homeserver = val; }
                    bg-color: #000000;
                    is-homeserver: true;
                    enabled: !root.loading;
                    accepted => { root.login(root.username, root.password, root.homeserver); }
                }

                if root.error != "" : Text {
                    text: root.error;
                    color: #ff5555;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle { height: 4px; }

                Rectangle {
                    height: 20px;
                    Text {
                        text: "forgot your password?";
                        color: f-ta.has-hover ? #38BDF8 : #818CF8;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: 90ms; easing: ease; }
                    }
                    f-ta := TouchArea {
                        clicked => { root.forgot_password(); }
                        mouse-cursor: pointer;
                    }
                }

                Rectangle { height: 12px; }

                HorizontalLayout {
                    alignment: center;
                    CustomButton {
                        text: root.loading ? "..." : "login";
                        enabled: !root.loading;
                        width: 150px;
                        clicked => { root.login(root.username, root.password, root.homeserver); }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 20px;
                    padding-top: 30px;
                    padding-bottom: 30px;

                    for provider in [
                        { id: "google", img: @image-url("../static/google.svg") },
                        { id: "github", img: @image-url("../static/github.svg") },
                        { id: "apple", img: @image-url("../static/apple.svg") },
                        { id: "facebook", img: @image-url("../static/facebook.svg") },
                        { id: "gitlab", img: @image-url("../static/gitlab.svg") }
                    ] : OAuthIcon {
                        icon: provider.img;
                        provider-id: provider.id;
                        clicked(id) => { root.oauth_action("login", id); }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: 8px;
                    CustomButton {
                        text: "register";
                        enabled: !root.loading;
                        width: parent.width * 0.8;
                        clicked => { root.oauth_action("register", root.homeserver); }
                    }
                }

                Rectangle { height: 16px; }

                Rectangle {
                    height: 32px;
                    Text {
                        text: "→ open chat (dev)";
                        color: chat-ta.has-hover ? #38BDF8 : rgba(56, 189, 248, 0.45);
                        font-size: 13px;
                        letter-spacing: 0.39px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: 90ms; easing: ease; }
                    }
                    chat-ta := TouchArea {
                        clicked => { root.active-page = 1; root.open_chat(); }
                        mouse-cursor: pointer;
                    }
                }

                Rectangle {
                    height: 24px;
                    Text {
                        text: "→ debug console (dev)";
                        color: debug-ta.has-hover ? #38BDF8 : rgba(56, 189, 248, 0.45);
                        font-size: 13px;
                        letter-spacing: 0.39px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: 90ms; easing: ease; }
                    }
                    debug-ta := TouchArea {
                        clicked => { root.active-page = 2; }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    if active-page == 1 : ChatPage {}

    if active-page == 2 : DebugPage {
        commands: root.debug-commands;
        busy: root.debug-busy;
        output: root.debug-output;
        back => { root.active-page = 0; }
        run(cmd, a0, a1, a2, a3) => { root.debug-run-command(cmd, a0, a1, a2, a3); }
    }
}
