import { UiState } from "../app-state.slint";
import { CustomButton } from "../components/button.slint";

// Full-window settings surface that stays mounted while it slides closed.
export component SettingsDrawer inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: overlay-active;
    background: transparent;

    in-out property <bool> overlay-active: false;
    property <bool> drawer-open: UiState.settings-open;

    changed drawer-open => {
        if drawer-open {
            root.overlay-active = true;
            focus-scope.focus();
        }
    }

    Timer {
        running: root.overlay-active && !UiState.settings-open;
        interval: 220ms;
        triggered => { root.overlay-active = false; }
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                UiState.settings-open = false;
                accept
            } else {
                if (root.overlay-active) { accept } else { reject }
            }
        }

        // Eat pointer events throughout the closing transition too.
        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            width: 100%;
            height: 100%;
            y: UiState.settings-open ? 0px : parent.height;
            background: #090B14;
            animate y { duration: 200ms; easing: ease-in-out; }

            Text {
                text: "settings";
                x: 40px;
                y: 40px;
                color: #FFFFFF;
                font-size: 28px;
                font-weight: 700;
                font-family: "JetBrains Mono";
            }

            Rectangle {
                width: 44px;
                height: 44px;
                x: parent.width - 60px;
                y: 32px;
                border-radius: 22px;
                background: close-ta.has-hover ? rgba(255, 255, 255, 0.15) : transparent;
                Text {
                    text: "✕";
                    color: #FFFFFF;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                close-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { UiState.settings-open = false; }
                }
            }

            VerticalLayout {
                x: 40px;
                y: 120px;
                width: min(parent.width - 80px, 480px);
                height: self.preferred-height;
                alignment: start;
                spacing: 16px;
                CustomButton {
                    text: "log out";
                    width: 150px;
                    bg-color: #10121B;
                    border-color-normal: #34384E;
                    border-color-hover: #7180C7;
                    text-color: #FFFFFF;
                    clicked => { }
                }
            }
        }
    }

    init => {
        if (UiState.settings-open) {
            root.overlay-active = true;
            focus-scope.focus();
        }
    }
}
