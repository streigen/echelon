import { UiState } from "../app-state.slint";
import { CustomButton } from "../components/button.slint";

// Full-window settings surface that stays mounted while it slides closed.
export component SettingsDrawer inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: overlay-active;
    background: transparent;

    in-out property <bool> overlay-active: false;
    property <bool> drawer-open: UiState.settings-open;

    changed drawer-open => {
        if drawer-open {
            root.overlay-active = true;
            focus-scope.focus();
        }
    }

    Timer {
        running: root.overlay-active && !UiState.settings-open;
        interval: 220ms;
        triggered => { root.overlay-active = false; }
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (!UiState.logout-busy) {
                    UiState.settings-open = false;
                }
                accept
            } else {
                if (root.overlay-active) { accept } else { reject }
            }
        }

        // Eat pointer events throughout the closing transition too.
        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            width: 100%;
            height: 100%;
            y: UiState.settings-open ? 0px : parent.height;
            background: #04050aff;
            animate y { duration: 200ms; easing: ease-in-out; }

            VerticalLayout {
                width: 100%;
                height: 100%;

                // Header: settings icon and title.
                Rectangle {
                    height: 160px;
                    background: transparent;

                    Image {
                        source: @image-url("../../static/settings.svg");
                        x: (parent.width - 64px) / 2;
                        y: 28px;
                        width: 64px;
                        height: 64px;
                        colorize: #40529F;
                        transform-rotation: UiState.settings-open ? 360deg : 0deg;
                        animate transform-rotation {
                            duration: UiState.settings-open ? 500ms : 0ms;
                            delay: UiState.settings-open ? 200ms : 0ms;
                            easing: ease-in-out;
                        }
                    }

                    Text {
                        text: "Settings";
                        x: 0px;
                        y: 104px;
                        width: 100%;
                        height: 36px;
                        color: #FFFFFF;
                        font-size: 28px;
                        font-weight: 700;
                        font-family: "JetBrains Mono";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Add future settings controls inside this scroll area.
                categories-content := Flickable {
                    width: 100%;
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: categories-layout.preferred-height;

                    categories-layout := VerticalLayout {
                        width: categories-content.width;
                        alignment: start;
                        padding: 24px;
                        spacing: 16px;
                    }
                }

                // Footer stays at the bottom as the drawer resizes.
                VerticalLayout {
                    height: 88px;
                    alignment: end;
                    padding-bottom: 36px;

                    HorizontalLayout {
                        width: 100%;
                        height: 48px;
                        alignment: center;

                        CustomButton {
                            text: UiState.logout-busy ? "logging out..." : "log out";
                            enabled: !UiState.logout-busy;
                            width: 180px;
                            bg-color: transparent;
                            border-color-normal: #ED4245;
                            border-color-hover: #FF6265;
                            text-color: #ED4245;
                            clicked => { UiState.logout(); }
                        }
                    }
                }
            }

            Rectangle {
                width: 44px;
                height: 44px;
                x: parent.width - 60px;
                y: 32px;
                border-radius: 22px;
                background: close-ta.has-hover ? rgba(255, 255, 255, 0.15) : transparent;
                Text {
                    text: "✕";
                    color: #FFFFFF;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                close-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        if (!UiState.logout-busy) {
                            UiState.settings-open = false;
                        }
                    }
                }
            }
        }
    }

    init => {
        if (UiState.settings-open) {
            root.overlay-active = true;
            focus-scope.focus();
        }
    }
}
