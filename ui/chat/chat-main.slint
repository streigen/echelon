import "../../static/JetBrainsMono-Regular.ttf";
import { UiState, Message } from "../app-state.slint";
import { ListView } from "std-widgets.slint";
import { ChatHeader } from "./chat-header.slint";
import { ChatComposer } from "./chat-composer.slint";

export component ChatMain inherits Rectangle {
    background: #000000;
    
    dummy-focus := FocusScope {}
    
    VerticalLayout {
        // Header
        ChatHeader {}
        
        // Messages Area
        Rectangle {
            msg-listview := ListView {
                height: 100%;
                width: 100%;
                
                for msg[idx] in UiState.messages : VerticalLayout {
                    padding-bottom: 24px;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: idx == 0 ? 24px : 0px;
                    
                    Rectangle {
                        background: msg-ta.has-hover || reply-ta.has-hover ? rgba(255, 255, 255, 0.04) : transparent;
                        border-radius: 8px;
                        animate background { duration: 150ms; }
                        
                        msg-ta := TouchArea {
                            width: 100%; height: 100%;
                            mouse-cursor: default;
                            clicked => { dummy-focus.focus(); }
                        }
                        
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 16px;
                            alignment: start;
                            
                            // Avatar
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: #d9dde4;
                            }
                            
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                
                                if msg.repliedTo != "" : HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Image { source: @image-url("../../static/reply-right.svg"); width: 14px; height: 14px; colorize: rgba(255, 255, 255, 0.55); }
                                    }
                                    Text { text: msg.repliedTo; color: rgba(255, 255, 255, 0.55); font-size: 12px; vertical-alignment: center; }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    Text { text: msg.user; color: #FFFFFF; font-weight: 700; font-size: 15px; }
                                    Text { text: msg.time; color: #40529F; font-size: 13px; }
                                }
                                
                                Text { text: msg.text; color: rgba(255, 255, 255, 0.85); font-size: 15px; wrap: word-wrap; }
                                
                                if msg.image : Rectangle {
                                    width: 200px;
                                    height: 120px;
                                    background: #c9ccd1;
                                    border-radius: 8px;
                                    Text { text: "LET IT BURN"; color: #00050e; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        
                        // Floating reply button
                        reply-btn := Rectangle {
                            visible: msg-ta.has-hover || reply-ta.has-hover;
                            x: parent.width - 48px;
                            y: (parent.height - self.height) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: reply-ta.has-hover ? #2D1B8E : transparent;
                            animate background { duration: 150ms; }
                            
                            Image {
                                source: @image-url("../../static/reply.svg");
                                width: 16px;
                                height: 16px;
                                colorize: reply-ta.has-hover ? #FFFFFF : rgba(255, 255, 255, 0.55);
                                x: 8px;
                                y: 8px;
                                animate colorize { duration: 150ms; }
                            }
                            
                            reply-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
        
        // Composer area
        ChatComposer {}
    }
}
