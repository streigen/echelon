import "../../static/JetBrainsMono-Regular.ttf";
import { CustomInput } from "../components/input-field.slint";

export struct Message {
    user: string,
    time: string,
    text: string,
    repliedTo: string,
    image: bool,
}

export component ChatMain inherits Rectangle {
    background: #000000;
    
    in-out property <string> active-room: "general";
    in-out property <bool> participants-visible: true;
    
    callback send-message(string);
    
    in-out property <[Message]> messages;
    
    dummy-focus := FocusScope {}
    
    VerticalLayout {
        // Header
        Rectangle {
            height: 64px;
            background: transparent;
            
            Rectangle {
                y: parent.height - 1px;
                x: 16px;
                width: parent.width - 32px;
                height: 1px;
                background: rgba(255, 255, 255, 0.18);
            }
            
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;
                
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    
                    Image { source: @image-url("../../static/dropdown.svg"); width: 24px; height: 24px; colorize: rgba(255, 255, 255, 0.55); y: 20px;}
                    VerticalLayout {
                        alignment: center;
                        Text { text: root.active-room; color: #FFFFFF; font-size: 18px; font-weight: 700; }
                        Text { text: "matrix.org"; color: #40529F; font-size: 12px; }
                    }
                }
                
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;
                    
                    Image { source: @image-url("../../static/pin.svg"); width: 24px; height: 24px; colorize: rgba(255, 255, 255, 0.55); y: 20px;}
                    Rectangle {
                        width: 24px; height: 24px; y: 20px;
                        Image { source: @image-url("../../static/members.svg"); width: 24px; height: 24px; colorize: root.participants-visible ? #38BDF8 : rgba(255, 255, 255, 0.55); }
                        TouchArea { clicked => { root.participants-visible = !root.participants-visible; } mouse-cursor: pointer; }
                    }
                }
            }
        }
        
        // Messages Area
        Rectangle {
            msg-flickable := Flickable {
                height: 100%;
                width: 100%;
                viewport-height: msg-layout.preferred-height;
                
                changed viewport-height => {
                    self.viewport-y = min(0px, self.height - self.viewport-height);
                }
                
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { dummy-focus.focus(); }
                }
                
                msg-layout := VerticalLayout {
                    padding: 24px;
                    spacing: 24px;
                    alignment: start;
                    
                    for msg in root.messages : Rectangle {
                        background: msg-ta.has-hover || reply-ta.has-hover ? rgba(255, 255, 255, 0.04) : transparent;
                        border-radius: 8px;
                        animate background { duration: 150ms; }
                        
                        msg-ta := TouchArea {
                            width: 100%; height: 100%;
                            mouse-cursor: default;
                            clicked => { dummy-focus.focus(); }
                        }
                        
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 16px;
                            alignment: start;
                            
                            // Avatar
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: #d9dde4;
                            }
                            
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                
                                if msg.repliedTo != "" : HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Image { source: @image-url("../../static/reply-right.svg"); width: 14px; height: 14px; colorize: rgba(255, 255, 255, 0.55); }
                                    }
                                    Text { text: msg.repliedTo; color: rgba(255, 255, 255, 0.55); font-size: 12px; vertical-alignment: center; }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    Text { text: msg.user; color: #FFFFFF; font-weight: 700; font-size: 15px; }
                                    Text { text: msg.time; color: #40529F; font-size: 13px; }
                                }
                                
                                Text { text: msg.text; color: rgba(255, 255, 255, 0.85); font-size: 15px; wrap: word-wrap; }
                                
                                if msg.image : Rectangle {
                                    width: 200px;
                                    height: 120px;
                                    background: #c9ccd1;
                                    border-radius: 8px;
                                    Text { text: "LET IT BURN"; color: #00050e; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        
                        // Floating reply button
                        reply-btn := Rectangle {
                            visible: msg-ta.has-hover || reply-ta.has-hover;
                            x: parent.width - 48px;
                            y: (parent.height - self.height) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: reply-ta.has-hover ? #2D1B8E : transparent;
                            animate background { duration: 150ms; }
                            
                            Image {
                                source: @image-url("../../static/reply.svg");
                                width: 16px;
                                height: 16px;
                                colorize: reply-ta.has-hover ? #FFFFFF : rgba(255, 255, 255, 0.55);
                                x: 8px;
                                y: 8px;
                                animate colorize { duration: 150ms; }
                            }
                            
                            reply-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
        
        // Composer area
        Rectangle {
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 14px;
                
                // Typing indicator
                Rectangle {
                    height: 20px;
                    HorizontalLayout {
                        padding-left: 64px;
                        Text { text: "... flaxeneel2 is typing"; color: rgba(255, 255, 255, 0.55); font-size: 12px; font-weight: 700; }
                    }
                }
                
                // Composer
                HorizontalLayout {
                    spacing: 12px;
                    
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        vertical-stretch: 0;
                        background: #000000;
                        border-radius: 24px;
                        Image { source: @image-url("../../static/attach.svg"); width: 24px; height: 24px; colorize: rgba(255, 255, 255, 0.7); y: 12px; x: 12px;}
                        TouchArea { mouse-cursor: pointer; }
                    }
                    
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #000000;
                        border-width: 2px;
                        border-color: chat-edit.has-focus ? #38BDF8 : #1a2255;
                        border-top-left-radius: 20px;
                        border-bottom-right-radius: 20px;
                        drop-shadow-color: chat-edit.has-focus ? #38BDF8.with-alpha(0.25) : transparent;
                        drop-shadow-blur: chat-edit.has-focus ? 10px : 0px;
                        animate border-color { duration: 200ms; easing: ease; }
                        animate drop-shadow-color { duration: 200ms; easing: ease; }
                        animate drop-shadow-blur { duration: 200ms; easing: ease; }
                        height: min(250px, max(48px, chat-edit.preferred-height + 24px));
                        clip: true;
                        
                        chat-flickable := Flickable {
                            width: 100%;
                            height: 100%;
                            viewport-height: max(48px, chat-edit.preferred-height + 24px);
                            
                            chat-edit := TextInput {
                                x: 18px;
                                y: (parent.viewport-height - self.height) / 2;
                                width: parent.width - 36px;
                                height: self.preferred-height;
                                wrap: word-wrap;
                                single-line: false;
                                color: #FFFFFF;
                                font-size: 16px;
                                font-family: "JetBrains Mono";
                                vertical-alignment: center;
                                
                                edited => {
                                    chat-flickable.viewport-y = min(0px, chat-flickable.height - chat-flickable.viewport-height);
                                }
                                
                                key-pressed(event) => {
                                    if (event.text == "\n" && !event.modifiers.shift) {
                                        if (self.text != "") {
                                            root.send-message(self.text);
                                            self.text = "";
                                        }
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            
                            if chat-edit.text == "" : Text {
                                text: "enter a message...";
                                color: chat-edit.has-focus ? rgba(255, 255, 255, 0.3) : rgba(255, 255, 255, 0.55);
                                font-size: 16px;
                                font-family: "JetBrains Mono";
                                x: 18px;
                                y: (parent.viewport-height - self.preferred-height) / 2;
                                animate color { duration: 200ms; easing: ease; }
                            }
                        }
                    }
                    
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        background: #2D1B8E;
                        border-radius: 24px;
                        vertical-stretch: 0;
                        Image { source: @image-url("../../static/send.svg"); width: 20px; height: 20px; colorize: #FFFFFF; y: 14px; x: 14px;}
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (chat-edit.text != "") {
                                    root.send-message(chat-edit.text);
                                    chat-edit.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
