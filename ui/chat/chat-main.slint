import "../../static/JetBrainsMono-Regular.ttf";
import { ChatHeader } from "./chat-header.slint";
import { ChatComposer } from "./chat-composer.slint";

export struct Message {
    user: string,
    time: string,
    text: string,
    repliedTo: string,
    image: bool,
}

export component ChatMain inherits Rectangle {
    background: #000000;
    
    in-out property <string> active-room: "general";
    in-out property <bool> participants-visible: true;
    
    callback send-message(string);
    
    in-out property <[Message]> messages;
    
    dummy-focus := FocusScope {}
    
    VerticalLayout {
        // Header
        ChatHeader {
            active-room <=> root.active-room;
            participants-visible <=> root.participants-visible;
        }
        
        // Messages Area
        Rectangle {
            msg-flickable := Flickable {
                height: 100%;
                width: 100%;
                viewport-height: msg-layout.preferred-height;
                
                // CPU Optimization Note: 
                // We keep the viewport-height observer simple, but avoid aggressive re-anchoring
                // if it's already close to the bottom. But for now we stick to standard Slint behavior.
                changed viewport-height => {
                    self.viewport-y = min(0px, self.height - self.viewport-height);
                }
                
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { dummy-focus.focus(); }
                }
                
                msg-layout := VerticalLayout {
                    padding: 24px;
                    spacing: 24px;
                    alignment: start;
                    
                    for msg in root.messages : Rectangle {
                        background: msg-ta.has-hover || reply-ta.has-hover ? rgba(255, 255, 255, 0.04) : transparent;
                        border-radius: 8px;
                        animate background { duration: 150ms; }
                        
                        msg-ta := TouchArea {
                            width: 100%; height: 100%;
                            mouse-cursor: default;
                            clicked => { dummy-focus.focus(); }
                        }
                        
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 16px;
                            alignment: start;
                            
                            // Avatar
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: #d9dde4;
                            }
                            
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                
                                if msg.repliedTo != "" : HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Image { source: @image-url("../../static/reply-right.svg"); width: 14px; height: 14px; colorize: rgba(255, 255, 255, 0.55); }
                                    }
                                    Text { text: msg.repliedTo; color: rgba(255, 255, 255, 0.55); font-size: 12px; vertical-alignment: center; }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    Text { text: msg.user; color: #FFFFFF; font-weight: 700; font-size: 15px; }
                                    Text { text: msg.time; color: #40529F; font-size: 13px; }
                                }
                                
                                Text { text: msg.text; color: rgba(255, 255, 255, 0.85); font-size: 15px; wrap: word-wrap; }
                                
                                if msg.image : Rectangle {
                                    width: 200px;
                                    height: 120px;
                                    background: #c9ccd1;
                                    border-radius: 8px;
                                    Text { text: "LET IT BURN"; color: #00050e; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        
                        // Floating reply button
                        reply-btn := Rectangle {
                            visible: msg-ta.has-hover || reply-ta.has-hover;
                            x: parent.width - 48px;
                            y: (parent.height - self.height) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: reply-ta.has-hover ? #2D1B8E : transparent;
                            animate background { duration: 150ms; }
                            
                            Image {
                                source: @image-url("../../static/reply.svg");
                                width: 16px;
                                height: 16px;
                                colorize: reply-ta.has-hover ? #FFFFFF : rgba(255, 255, 255, 0.55);
                                x: 8px;
                                y: 8px;
                                animate colorize { duration: 150ms; }
                            }
                            
                            reply-ta := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
        
        // Composer area
        ChatComposer {
            send-message(msg) => { root.send-message(msg); }
        }
    }
}
