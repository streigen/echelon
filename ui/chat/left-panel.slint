import { SpacesBar } from "./spaces-bar.slint";
import { RoomsSidebar, CategoryData } from "./rooms-sidebar.slint";
import { UserBar } from "./user-bar.slint";

export component LeftPanel inherits Rectangle {
    in-out property <bool> sidebar-collapsed: false;
    in-out property <string> active-room: "general";
    property <string> active-room-space0: "general";
    property <string> active-room-space1: "mission-control";
    in-out property <string> active-voice-room: "";
    in-out property <bool> muted: false;
    in-out property <bool> deafened: false;
    in-out property <int> active-space: 0;
    
    property <[CategoryData]> space-0: [
        { name: "ROOMS", collapsed: false, rooms: [
            { name: "announcements", r_type: "text", encrypted: true },
            { name: "general", r_type: "text", encrypted: true },
            { name: "very trustworthy", r_type: "text", encrypted: false },
            { name: "very trustworthy x2", r_type: "text", encrypted: false },
        ]},
        { name: "COOKING", collapsed: false, rooms: [
            { name: "cookies", r_type: "text", encrypted: false },
            { name: "creme", r_type: "text", encrypted: true },
        ]},
        { name: "VOICE ROOMS", collapsed: false, rooms: [
            { name: "voice room", r_type: "voice", encrypted: false },
        ]},
    ];
    
    property <[CategoryData]> space-1: [
        { name: "SECRET BASE", collapsed: false, rooms: [
            { name: "mission-control", r_type: "text", encrypted: true },
            { name: "intel", r_type: "text", encrypted: true },
        ]},
        { name: "HANG OUT", collapsed: false, rooms: [
            { name: "gaming", r_type: "voice", encrypted: false },
            { name: "chill zone", r_type: "voice", encrypted: false },
        ]},
    ];

    in-out property <[CategoryData]> categories: root.active-space == 0 ? root.space-0 : root.space-1;
    
    in-out property <[string]> voice-participants: ["Clumsy ☆", "Human", "flaxeneel2"];
    
    background: #000000;
    
    VerticalLayout {
        // TOP SECTION: Spaces Bar + Rooms Sidebar
        HorizontalLayout {
            SpacesBar {
                sidebar-collapsed <=> root.sidebar-collapsed;
                active-space: root.active-space;
                space-clicked(idx) => {
                    root.active-space = idx;
                    root.active-room = idx == 0 ? root.active-room-space0 : root.active-room-space1;
                }
            }
            RoomsSidebar {
                sidebar-collapsed <=> root.sidebar-collapsed;
                active-room <=> root.active-room;
                active-voice-room <=> root.active-voice-room;
                voice-participants <=> root.voice-participants;
                categories <=> root.categories;
                room-clicked(name, r_type) => {
                    if r_type == "text" {
                        if root.active-space == 0 {
                            root.active-room-space0 = name;
                        } else {
                            root.active-room-space1 = name;
                        }
                        root.active-room = name;
                    } else {
                        root.active-voice-room = (root.active-voice-room == name) ? "" : name;
                    }
                }
            }
        }
        
        // BOTTOM SECTION: User Bar (Extends all the way left)
        UserBar {
            sidebar-collapsed <=> root.sidebar-collapsed;
            active-voice-room <=> root.active-voice-room;
            muted <=> root.muted;
            deafened <=> root.deafened;
        }
    }
}
