import { UiState, RoomData } from "../app-state.slint";
import { SpacesBar } from "./spaces-bar.slint";
import { RoomsSidebar } from "./rooms-sidebar.slint";
import { UserBar } from "./user-bar.slint";

export component LeftPanel inherits Rectangle {
    in-out property <[string]> voice-participants: ["Clumsy ☆", "Human", "flaxeneel2"];

    background: #000000;
    clip: true;

    VerticalLayout {
        // TOP SECTION: Spaces Bar + Rooms Sidebar
        HorizontalLayout {
            SpacesBar {
                space-clicked(idx) => {
                    UiState.space-clicked(idx);
                }
            }
            RoomsSidebar {
                voice-participants: root.voice-participants;
                categories: UiState.categories;
                toggle-category(idx) => {
                    UiState.categories[idx].collapsed = !UiState.categories[idx].collapsed;
                }
                room-clicked(room) => {
                    if room.r_type == "text" {
                        UiState.channel-clicked(room.id, room.name);
                    } else {
                        UiState.active-voice-room = (UiState.active-voice-room == room.name) ? "" : room.name;
                    }
                }
            }
        }

        // BOTTOM SECTION: User Bar (Extends all the way left)
        UserBar {}
    }
}
