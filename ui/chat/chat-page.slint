import "../../static/JetBrainsMono-Regular.ttf";
import { UiState } from "../app-state.slint";
import { LeftPanel } from "./left-panel.slint";
import { ChatMain } from "./chat-main.slint";
import { ParticipantsPanel } from "./participants-panel.slint";

export component ChatPage inherits Rectangle {
    background: #000000;
    
    HorizontalLayout {
        // Background sidebar, animates width natively.
        LeftPanel {
            width: UiState.sidebar-collapsed ? 70px : 320px;
            animate width { duration: 100ms; easing: ease-in-out; }
        }
        
        // Main chat area - natively stretches to fill remaining space.
        ChatMain {
            horizontal-stretch: 1;
        }
        
        if UiState.participants-visible : ParticipantsPanel {
            width: 250px;
        }
    }
}
