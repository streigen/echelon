import "../../static/JetBrainsMono-Regular.ttf";
import { UiState } from "../app-state.slint";

export component ChatComposer inherits Rectangle {
    callback message-sent();

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-bottom: 14px;
        
        // Typing indicator
        Rectangle {
            height: 20px;
            HorizontalLayout {
                padding-left: 64px;
                Text { text: "... flaxeneel2 is typing"; color: rgba(255, 255, 255, 0.55); font-size: 12px; font-weight: 700; }
            }
        }
        
        // Composer
        HorizontalLayout {
            spacing: 12px;
            
            Rectangle {
                width: 48px;
                height: 48px;
                vertical-stretch: 0;
                background: #000000;
                border-radius: 24px;
                Image { source: @image-url("../../static/attach.svg"); width: 24px; height: 24px; colorize: rgba(255, 255, 255, 0.7); y: 12px; x: 12px;}
                TouchArea { mouse-cursor: pointer; }
            }
            
            Rectangle {
                horizontal-stretch: 1;
                background: #000000;
                border-width: 2px;
                border-color: chat-edit.has-focus ? #38BDF8 : #1a2255;
                border-top-left-radius: 20px;
                border-bottom-right-radius: 20px;

                height: min(250px, max(48px, chat-edit.preferred-height + 24px));
                clip: true;
                
                chat-flickable := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-height: max(48px, compose-layout.preferred-height);
                    
                    compose-layout := VerticalLayout {
                        width: chat-flickable.width;
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        alignment: center;
                        
                        chat-edit := TextInput {
                            height: self.preferred-height;
                            wrap: word-wrap;
                            single-line: false;
                            color: #FFFFFF;
                            font-size: 16px;
                            font-family: "JetBrains Mono";
                            vertical-alignment: center;
                            
                            edited => {
                                chat-flickable.viewport-y = min(0px, chat-flickable.height - chat-flickable.viewport-height);
                            }
                            
                            key-pressed(event) => {
                                if (event.text == "\n" && !event.modifiers.shift) {
                                    if (self.text != "") {
                                        UiState.send-message(self.text);
                                        self.text = "";
                                        root.message-sent();
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                    
                    if chat-edit.text == "" : Text {
                        text: "enter a message...";
                        color: chat-edit.has-focus ? rgba(255, 255, 255, 0.3) : rgba(255, 255, 255, 0.55);
                        font-size: 16px;
                        font-family: "JetBrains Mono";
                        x: 18px;
                        y: 12px;
                    }
                }
            }
            
            Rectangle {
                width: 48px;
                height: 48px;
                background: #2D1B8E;
                border-radius: 24px;
                vertical-stretch: 0;
                Image { source: @image-url("../../static/send.svg"); width: 20px; height: 20px; colorize: #FFFFFF; y: 14px; x: 14px;}
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (chat-edit.text != "") {
                            UiState.send-message(chat-edit.text);
                            chat-edit.text = "";
                        }
                    }
                }
            }
        }
    }
}
