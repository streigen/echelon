import { Message } from "../app-state.slint";

export component MessageRow inherits VerticalLayout {
    in property <Message> msg;
    in property <bool> is-first: false;

    callback reply-clicked();

    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: is-first ? 24px : 0px;

    row-focus := FocusScope {}

    row-rect := Rectangle {
        property <float> hover-opacity: 0.0;
        property <bool> raw-hovering: msg-ta.has-hover || reply-ta.has-hover;
        property <bool> is-hovering: false;

        background: transparent;
        border-radius: 8px;

        // 150ms hover-intent gate — cancels if mouse leaves before firing
        Timer {
            interval: 150ms;
            running: row-rect.raw-hovering && !row-rect.is-hovering;
            triggered => { row-rect.is-hovering = row-rect.raw-hovering; }
        }

        // 30fps fade — drives hover-opacity, resets is-hovering on fade-out
        Timer {
            interval: 33ms;
            running: (row-rect.is-hovering && row-rect.hover-opacity < 1.0)
                  || (!row-rect.raw-hovering && row-rect.hover-opacity > 0.0);
            triggered => {
                if (!row-rect.raw-hovering) {
                    row-rect.is-hovering = false;
                    row-rect.hover-opacity = max(row-rect.hover-opacity - 0.4, 0.0);
                } else {
                    row-rect.hover-opacity = min(row-rect.hover-opacity + 0.4, 1.0);
                }
            }
        }

        Rectangle {
            background: rgba(255, 255, 255, 0.04);
            border-radius: 8px;
            opacity: row-rect.hover-opacity;
            width: 100%; height: 100%;
        }

        msg-ta := TouchArea {
            width: 100%; height: 100%;
            mouse-cursor: default;
            clicked => { row-focus.focus(); }
        }

        HorizontalLayout {
            padding: 12px;
            spacing: 16px;
            alignment: start;

            // Avatar
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: #d9dde4;
            }

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                if msg.repliedTo != "" : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../../static/reply-right.svg"); width: 14px; height: 14px; colorize: rgba(255, 255, 255, 0.55); }
                    }
                    Text { text: msg.repliedTo; color: rgba(255, 255, 255, 0.55); font-size: 12px; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: msg.user; color: #FFFFFF; font-weight: 700; font-size: 15px; }
                    Text { text: msg.time; color: #40529F; font-size: 13px; }
                }

                Text { text: msg.text; color: rgba(255, 255, 255, 0.85); font-size: 15px; wrap: word-wrap; }

                if msg.image : Rectangle {
                    width: 200px;
                    height: 120px;
                    background: #c9ccd1;
                    border-radius: 8px;
                    Text { text: "LET IT BURN"; color: #00050e; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // Floating reply button — shares row-rect.hover-opacity
        reply-btn := Rectangle {
            opacity: row-rect.hover-opacity;
            x: parent.width - 48px;
            y: (parent.height - self.height) / 2;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: transparent;

            Rectangle {
                background: #2D1B8E;
                border-radius: 16px;
                opacity: reply-ta.has-hover ? 1.0 : 0.0;
                width: 100%; height: 100%;
            }

            Image {
                source: @image-url("../../static/reply.svg");
                width: 16px;
                height: 16px;
                colorize: reply-ta.has-hover ? #FFFFFF : rgba(255, 255, 255, 0.55);
                x: 8px;
                y: 8px;
            }

            reply-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.reply-clicked(); }
            }
        }
    }
}
