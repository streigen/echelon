import { Message, MessageAttachment, AttachmentKind } from "../app-state.slint";

export component MessageRow inherits VerticalLayout {
    in property <Message> msg;
    in property <bool> is-first: false;
    // This row's position in the model, passed along with every visibility report so
    // Rust can go straight to the row instead of searching for it.
    in property <int> index;

    // Slice of the scroll content, in the same coordinates as this row's `y`,
    // whose previews are worth keeping decoded. Supplied by chat-main.
    in property <length> keep-top;
    in property <length> keep-bottom;

    callback reply-clicked();
    // chat-main.slint pairs this with msg.event-id to call
    // UiState.open-lightbox.
    callback attachment-clicked();
    // Same, for UiState.save-attachment. Only reachable from kinds with no preview, since
    // previewable ones offer this inside the lightbox instead.
    callback attachment-save-clicked();
    // Fires on entering/leaving the keep band, and once at construction.
    // See `flush_preview_window` in lib.rs.
    callback preview-window-changed(bool);

    property <bool> in-keep-window: self.y + self.height >= keep-top && self.y <= keep-bottom;

    changed in-keep-window => { root.preview-window-changed(in-keep-window); }
    // Geometry isn't measured yet here, so this first report is a guess; the
    // `changed` above corrects it once laid out, within Rust's debounce.
    init => { root.preview-window-changed(in-keep-window); }

    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: is-first ? 24px : 0px;

    row-focus := FocusScope {}

    row-rect := Rectangle {
        property <bool> is-hovering: msg-ta.has-hover || reply-ta.has-hover;

        background: transparent;
        border-radius: 8px;

        Rectangle {
            background: rgba(255, 255, 255, 0.04);
            border-radius: 8px;
            opacity: row-rect.is-hovering ? 1.0 : 0.0;
            width: 100%; height: 100%;
        }

        msg-ta := TouchArea {
            width: 100%; height: 100%;
            mouse-cursor: default;
            clicked => { row-focus.focus(); }
        }

        HorizontalLayout {
            padding: 12px;
            spacing: 16px;
            alignment: start;

            // Dims the whole message, avatar included, while the send is
            // unacknowledged. Applied here rather than per-Text so nothing
            // added to the row later has to remember to dim itself.
            opacity: msg.pending ? 0.45 : 1.0;

            // Avatar
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: #d9dde4;
            }

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                if msg.repliedTo != "" : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../../static/reply-right.svg"); width: 14px; height: 14px; colorize: rgba(255, 255, 255, 0.55); }
                    }
                    Text { text: msg.repliedTo; color: rgba(255, 255, 255, 0.55); font-size: 12px; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: msg.user; color: #FFFFFF; font-weight: 700; font-size: 15px; }
                    Text { text: msg.time; color: #40529F; font-size: 13px; }
                }

                // The body and the "(edited)" marker sit in one row so the marker trails
                // the text instead of starting a line of its own. Neither Text stretches;
                // the filler after them takes the slack, which keeps the marker against
                // the body rather than against the row's right edge. When the body is
                // wider than the row the filler collapses and the body wraps.
                //
                // This layout is unconditional and the `if` sits on the body Text inside
                // it, which matters for wrapping: a conditional cell whose root is a
                // layout is measured for height at its own *preferred* (unwrapped) width,
                // since Slint passes no cross-axis constraint across a repeater boundary.
                // That gives a wrapping body one line of height and hides the rest. A
                // conditional whose root is the Text itself falls back to the Text's real
                // width instead, which is the case that measures correctly. The cost is
                // the layout's spacing on a row with no body, which is what the `if`
                // used to save.
                HorizontalLayout {
                    spacing: 6px;

                    // Empty for a bare attachment, where the body is only the file name
                    // (see `display_text` in lib.rs).
                    if msg.text != "" : Text {
                        text: msg.text;
                        color: rgba(255, 255, 255, 0.85);
                        font-size: 15px;
                        wrap: word-wrap;
                        horizontal-stretch: 0;
                    }

                    if msg.text != "" && msg.edited : Text {
                        text: "(edited)";
                        color: rgba(255, 255, 255, 0.35);
                        font-size: 11px;
                        // Bottom, so on a wrapped body it lines up with the last
                        // line rather than floating beside the middle of the block.
                        vertical-alignment: bottom;
                        horizontal-stretch: 0;
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                // Decided in Rust by `Attachment::previewable`, which is the kind
                // question and the size question together.
                if msg.attachment.previewable : Rectangle {
                    property <MessageAttachment> att: msg.attachment;
                    // Sender-declared size when there is one, else a
                    // placeholder box; capped so a huge image can't take the
                    // whole row.
                    property <bool> sized: att.width > 0 && att.height > 0;

                    width: sized ? min(att.width * 1px, 320px) : 280px;
                    height: sized ? self.width * att.height / att.width : 210px;
                    background: #1b1e27;
                    border-radius: 8px;
                    clip: true;

                    if att.preview.width > 0 : Rectangle {
                        width: 100%;
                        height: 100%;

                        Image {
                            source: att.preview;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.attachment-clicked(); }
                        }
                    }

                    if att.preview.width == 0 : Text {
                        text: "loading…";
                        color: rgba(255, 255, 255, 0.55);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Everything else with an attachment gets a card with the name, type
                // and a way to save it: video, audio and file, which have no renderer,
                // and images too big to be worth pulling down uninvited. Video stays
                // here rather than in the lightbox until there is a player to hand a
                // click to.
                if msg.attachment.kind != AttachmentKind.Empty
                    && !msg.attachment.previewable : Rectangle {
                    property <MessageAttachment> att: msg.attachment;

                    width: 320px;
                    height: card-layout.preferred-height;
                    background: #1b1e27;
                    border-radius: 8px;

                    // Every column but the text one is fixed width, so the slack goes to the
                    // text and the save button stays against the card's right edge whatever
                    // the name's length.
                    card-layout := HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: @image-url("../../static/attach.svg");
                                width: 18px;
                                height: 18px;
                                colorize: rgba(255, 255, 255, 0.55);
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;

                            // `elide` drops the minimum width to one ellipsis, so a long
                            // name shrinks to fit the card instead of widening it.
                            Text {
                                text: att.filename == "" ? "attachment" : att.filename;
                                color: rgba(255, 255, 255, 0.85);
                                font-size: 14px;
                                overflow: elide;
                            }
                            Text {
                                text: att.mimetype == "" ? "unknown type" : att.mimetype;
                                color: rgba(255, 255, 255, 0.45);
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        if att.savable : VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            save-btn := Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: save-ta.has-hover
                                    ? rgba(255, 255, 255, 0.12)
                                    : transparent;

                                Image {
                                    source: @image-url("../../static/download.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: save-ta.has-hover
                                        ? #FFFFFF
                                        : rgba(255, 255, 255, 0.55);
                                }

                                save-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.attachment-save-clicked(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay wrapper prevents reply-btn from expanding row-rect, breaking the implicit layout cycle!
        Rectangle {
            width: 100%; height: 100%;
            
            // Floating reply button — shares row-rect.is-hovering
            reply-btn := Rectangle {
                opacity: row-rect.is-hovering ? 1.0 : 0.0;
                x: parent.width - 48px;
                y: (parent.height - self.height) / 2;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: transparent;

            Rectangle {
                background: #2D1B8E;
                border-radius: 16px;
                opacity: reply-ta.has-hover ? 1.0 : 0.0;
                width: 100%; height: 100%;
            }

            Image {
                source: @image-url("../../static/reply.svg");
                width: 16px;
                height: 16px;
                colorize: reply-ta.has-hover ? #FFFFFF : rgba(255, 255, 255, 0.55);
                x: 8px;
                y: 8px;
            }

            reply-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.reply-clicked(); }
            }
            }
        }
    }
}
