// Global application state singleton.
// All components read/write shared state here directly,
// eliminating deep two-way binding chains that cause
// "long callback/instantiation chain" warnings.

// Mirrors `rooms::messages::AttachmentKind`, converted in lib.rs, plus
// `Empty` for "this message has no attachment". Slint has no optional type,
// so the Rust side's `Option<Attachment>` arrives as a default-constructed
// `MessageAttachment` whose kind is `Empty`. That is why `Empty` is first:
// a default-constructed struct has to mean "absent".
export enum AttachmentKind {
    Empty,
    Image,
    Video,
    Audio,
    File,
    Sticker,
}

// The media attachment on a message, whatever its kind. Raster kinds use
// `preview`; the rest carry enough metadata to render their own row without
// this struct needing per-kind fields.
export struct MessageAttachment {
    kind: AttachmentKind,
    // e.g. "audio/mpeg". Empty when the sender didn't declare one.
    mimetype: string,
    // Natural pixel size from the event (0 if absent), so the box can be
    // sized before the bytes land and nothing jumps afterwards.
    width: int,
    height: int,
    // Empty until the fetch patches it in; a zero-sized `preview` on a
    // previewable kind is what "still loading" means.
    preview: image,
}

export struct Message {
    user: string,
    time: string,
    text: string,
    repliedTo: string,
    // Identifies which message an in-flight attachment fetch belongs to,
    // so its result can be patched into the right row once it lands.
    event-id: string,
    // Kind `Empty` when the message carries no media. A Matrix
    // `m.room.message` has exactly one msgtype, so an event never has more
    // than one attachment; several files are several events.
    attachment: MessageAttachment,
}

// One channel/room, as shown in the sidebar. `id` is the Matrix room id
// (used to fetch messages); `name` is the display name.
export struct RoomData {
    id: string,
    name: string,
    r-type: string, // "text" | "voice"
    encrypted: bool,
}

export struct CategoryData {
    name: string,
    rooms: [RoomData],
    collapsed: bool,
}

// Category list for one space tab (root space). Cached in
// `UiState.space-channels` (index-aligned with `space-tabs`) so switching
// tabs doesn't need a backend round trip. Subspaces are folded in here as
// their own named categories rather than as separate tabs.
export struct SpaceChannels {
    categories: [CategoryData],
}

// One tab in the spaces bar. `id` is the Matrix room id of the space; `abbrev`
// is a short (<=2 char) label precomputed in Rust for the tab's icon.
export struct SpaceTab {
    id: string,
    name: string,
    abbrev: string,
}

// Describes one backend command for the generic debug console: its name and the
// (up to 4) positional argument labels it accepts. Populated from Rust at startup
// from the single source-of-truth command registry (commands::debug::COMMANDS).
export struct DebugCommand {
    name: string,
    arg-labels: [string],
}

export global UiState {
    // Chat state
    in-out property <string> active-room: "";
    in-out property <string> active-room-id: "";
    in-out property <[Message]> messages;
    in-out property <bool> messages-loading: false;
    // Event id to pass as `from` to fetch the next (older) page for the
    // currently open room; "" means there's nothing older left to load.
    in-out property <string> next-token: "";
    // True while an older-messages fetch is in flight, to stop
    // load-older-messages from firing repeatedly while scrolled to the top.
    in-out property <bool> loading-more: false;

    // Layout state
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> participants-visible: true;

    // Voice state
    in-out property <string> active-voice-room: "";
    in-out property <bool> muted: false;
    in-out property <bool> deafened: false;

    // Space state — populated from commands::spaces::get_space_hierarchy.
    in-out property <[SpaceTab]> space-tabs: [];
    in-out property <[SpaceChannels]> space-channels: []; // index-aligned with space-tabs
    in-out property <int> active-space-index: -1;
    in-out property <string> active-space-name: "";
    in-out property <[CategoryData]> categories: [];

    // Click-to-enlarge lightbox (see ui/components/lightbox.slint). Opens at
    // the attachment's declared size with a loading state; lib.rs patches in
    // the full-resolution image once it lands.
    in-out property <bool> lightbox-visible: false;
    in-out property <bool> lightbox-loading: false;
    in-out property <image> lightbox-image;
    in-out property <int> lightbox-width: 0;
    in-out property <int> lightbox-height: 0;

    // Callbacks to Rust backend
    callback space-clicked(int);
    callback channel-clicked(string, string); // room id, room name
    callback send-message(string);
    callback load-older-messages();
    callback open-lightbox(string); // event id
    callback close-lightbox();
    // event id, whether the row is in the preview keep band. Drives both
    // fetching and eviction; see chat-main.slint's preview-keep-*.
    callback preview-window-changed(string, bool);
}
